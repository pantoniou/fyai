{
  "steps": [
    {
      "match": {"body_contains": "start parent question background test"},
      "response": {"output": [{"type": "function_call", "call_id": "parent-agent", "name": "agent", "arguments": "{\"name\":\"asker\",\"task\":\"Ask your parent for a colour.\",\"background\":true}"}]}
    },
    {
      "match": {"body_contains": "You are a fyai sub-agent"},
      "response": {"output": [{"type": "function_call", "call_id": "child-ask", "name": "ask_parent", "arguments": "{\"name\":\"choice\",\"question\":\"Which colour should I use?\"}"}]}
    },
    {
      "match": {"body_contains": "started in the background"},
      "response": {"output": [{"type": "function_call", "call_id": "parent-wait", "name": "wait", "arguments": "{\"for\":\"asker\",\"seconds\":10}"}]}
    },
    {
      "match": {"body_contains": "question sent; wait for"},
      "response": {"output": [{"type": "function_call", "call_id": "child-wait", "name": "wait", "arguments": "{\"for\":\"choice\",\"seconds\":10}"}]}
    },
    {
      "match": {"body_contains": "[agent 'asker' is waiting for input"},
      "response": {"output": [{"type": "function_call", "call_id": "parent-answer", "name": "agent_message", "arguments": "{\"name\":\"asker\",\"message\":\"Use green.\",\"receipt\":\"reply1\",\"reply_to\":\"main/agent:asker:choice\"}"}]}
    },
    {
      "match": {"body_contains": "[ask_parent 'choice' answered]"},
      "response": {"output": [{"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "I will use green."}]}]}
    },
    {
      "match": {"body_contains": "message sent; wait for 'reply1'"},
      "response": {"output": [{"type": "function_call", "call_id": "parent-finish-wait", "name": "wait", "arguments": "{\"for\":\"asker\",\"seconds\":10}"}]}
    },
    {
      "match": {"body_contains": "[agent 'asker' finished]"},
      "response": {"output": [{"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "Parent received green report."}]}]}
    }
  ]
}
