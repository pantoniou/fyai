{
  "steps": [
    {
      "match": {
        "http": "POST",
        "path": "/v1/chat/completions",
        "body_contains": "Start the long job"
      },
      "response": {
        "id": "c-bg-1",
        "object": "chat.completion",
        "model": "mock-model",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_bg",
                  "type": "function",
                  "function": {
                    "name": "read_file",
                    "arguments": "{\"path\": \"data.txt\"}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "match": {
        "http": "POST",
        "path": "/v1/chat/completions",
        "body_contains": "one line"
      },
      "response": {
        "id": "c-bg-2",
        "object": "chat.completion",
        "model": "mock-model",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "Continued without a message."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 4,
          "total_tokens": 14
        }
      },
      "wait_for": "release-durable"
    }
  ]
}