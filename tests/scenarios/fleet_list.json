{
  "steps": [
    {
      "match": {
        "http": "POST",
        "path": "/v1/chat/completions",
        "body_contains": "Start the jobs"
      },
      "response": {
        "id": "c-p-1",
        "object": "chat.completion",
        "model": "mock-model",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_w",
                  "type": "function",
                  "function": {
                    "name": "wait",
                    "arguments": "{\"name\": \"later\", \"seconds\": 2, \"reason\": \"check the thing\"}"
                  }
                },
                {
                  "id": "call_m",
                  "type": "function",
                  "function": {
                    "name": "monitor",
                    "arguments": "{\"name\": \"mon\", \"command\": \"echo up; sleep 100\", \"timeout\": 60000}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "match": {
        "http": "POST",
        "path": "/v1/chat/completions",
        "body_contains": "does not hold your turn"
      },
      "response": {
        "id": "c-p-2",
        "object": "chat.completion",
        "model": "mock-model",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "Jobs started."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 4,
          "total_tokens": 14
        }
      },
      "wait_for": "release-pending"
    },
    {
      "match": {
        "body_contains": "Say done"
      },
      "response": {
        "id": "c-park",
        "object": "chat.completion",
        "model": "mock-model",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "All done."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 4,
          "total_tokens": 14
        }
      }
    }
  ]
}
