# fyai configuration (sample)
#
# Use it as:
#   $XDG_CONFIG_HOME/fyai/config.yaml   (user bootstrap file,
#                                        else ~/.config/fyai/config.yaml)
#   fyai init / fyai config import <file>   (repository: ingested into the
#                                            selected branch in .fyai/arena)
# or pass any file explicitly with --config/-C (overlays the arena or bootstrap
# config; later command-line overlays still take precedence).
# Edit the repository config in place with `fyai config edit`, inspect it
# with `fyai config export`. Individual keys can be poked from the command
# line with `--set <key[=value]>` / `--get <key>` / `--delete <key>` (or the
# matching `fyai config set|get|delete` subcommands); keys are slash paths,
# e.g. `fyai --set display/color=on`. Add `--transient` to keep a session's
# edits (and its conversation state) in memory only.
#
# There is one persisted configuration source: the arena config. The user file
# above is bootstrap-only: it becomes the base only when the arena has no
# config, and is never overlaid onto one. The merged document is, in order:
#   arena config (or user bootstrap) -> --config file -> command-line overlays
# Built-in defaults back any key the merged document omits. The catalogue
# derives provider/url/grammar/wire-id read-only when the model resolves; those
# resolved values are not persisted as configuration intent.
#
# Every key below is set to its actual compiled-in default, explicitly -
# nothing is left to an invisible C-level default. Most run-shaping switches
# (temperature, reasoning, streaming, markdown rendering, stats, logprobs,
# obfuscation, ...) have no dedicated CLI flag at all; they are config keys
# only, poked via `config set` / `--set`. Stylistic options live under
# `display:`, logging controls under `logging:`.

# --- Model selection -------------------------------------------------------
#
# A single `model` key drives provider selection. The catalogue
# (`fyai catalog list`) maps the model to its canonical provider, endpoint
# URL, API grammar and provider wire-id. Prefix with `provider/` to pin a
# specific provider that also offers the model, e.g. `openrouter/glm-5.2`.
# Override on the command line with `--model`/`-m`.
model: gpt-5.4-mini

# `provider` is never a config key - it is derived read-only from `model` at
# resolve time and shown by `/model`, `/status`, `fyai list providers`, etc.

# Authentication selection. `auto` preserves API-key precedence and falls
# back to a machine-local ChatGPT login for OpenAI Responses requests.
auth: auto # auto | api-key | chatgpt

# API grammar: responses | chat-completions | messages. A model change
# re-derives it - and the endpoint - from the new model's provider, which
# offers the richest grammar it has, so both hold only until the model
# changes.
api: responses

# `api_url` is derived from the catalogue by default; set explicitly only to
# override the endpoint the catalogue resolves for the current model/api.
# api_url: https://api.openai.com/v1/responses

# Automatic API-key lookup tries `--api-key`/`-k`, the provider's conventional
# environment variable, then the logical secret `api-key/<provider>`.
# <PROVIDER>_API_KEY (OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# DEEPSEEK_API_KEY, GOOGLE_API_KEY...). Secrets are never written as raw values;
# Pin `type: env` or `type: secret` to require a particular indirection.
# The Linux backend is volatile across reboot; create an entry with
# `fyai secret set api-key/openai`. No raw credential appears here; `auto` is
# the compiled default.
api_key: { type: auto }
# api_key: { type: env, value: OPENAI_API_KEY }
# api_key: { type: secret, value: api-key/openai }

# --- Local / self-hosted models ---------------------------------------------
#
# Ollama, llama.cpp's llama-server, vLLM, LM Studio, text-generation-webui,
# ... all speak the OpenAI Chat Completions wire format already implemented
# above, and normally need no key. Point api_url at the local server, set
# no_auth so fyai neither requires nor sends a key, and pick whatever model
# name the server reports (`ollama list`, etc.) - no catalogue entry needed,
# since api_url is set explicitly.
# model: llama3
# api: chat-completions
# api_url: http://localhost:11434/v1/chat/completions
# no_auth: true

# --- Top-level defaults ----------------------------------------------------
system_prompt: You are a concise assistant.
parallel_tool_calls: true
parallel_tool_calls_prompt: >-
  Independent tool calls may be issued together in one response and will
  execute in parallel. Keep dependent or potentially conflicting tool calls
  in separate responses.
temperature: 0
max_tool_iterations: 1000
# Output-token cap per model call. Required by the Anthropic Messages API
# (sent on every request there); defaults from the catalogue otherwise.
max_tokens: 8192

# Automatic retry of a provider request that failed for a transient reason: a
# refused or lost connection, a timeout, or HTTP 408, 429, 500, 502, 503 or
# 504. The delay doubles after each attempt and keeps a random part, so
# parallel requests do not come back together; a `Retry-After` header replaces
# the calculated delay. `max_attempts` counts the first attempt (1 disables
# retry); `max_delay_ms` bounds one delay (0 removes the bound).
retry:
  max_attempts: 8
  initial_delay_ms: 500
  max_delay_ms: 30000

# Limits for the shell tool. `timeout_ms` (milliseconds) applies when the
# model gives no `timeout`; `max_timeout_ms` bounds the one it gives.
# Output is bounded too, because it becomes prompt text: a command that
# returns more than `max_output_tokens` keeps its end, since a command
# reports its conclusion last, and standard error is served first so the
# reason a command failed survives a noisy standard output.
# `hard_max_output_tokens` bounds a `max_output_tokens` the model gives.
# 0 disables any of these limits.
#
# `shell` and `login` decide the shell a call runs under when the call names
# neither: empty runs /bin/sh, and `login` reads the profile of the user.
#
# A call that asks for a terminal runs on a pseudo-terminal of `tty_rows` by
# `tty_cols` (0 follows the real terminal, else 24 by 80) with TERM set to
# `tty_term`. `tty` gives one to a call that asks for none, which is the only
# way to give the native Responses `shell_call` a terminal. A named session is
# ended after `session_timeout_ms` with no read and no write (0 never), and is
# asked every `input_poll_ms` whether its program waits for input (0 never).
shell:
  timeout_ms: 120000
  max_timeout_ms: 600000
  max_output_tokens: 16384
  hard_max_output_tokens: 200000
  shell: ""
  login: false
  tty: false
  tty_rows: 0
  tty_cols: 0
  tty_term: xterm-256color
  session_timeout_ms: 900000
  input_poll_ms: 400

# Size limits for read_file results, in bytes. `max_bytes` is the default.
# `hard_max_bytes` limits a value from the model. 0 disables a limit.
#
# Use `offset` and `limit` to read a window of lines. Use the reported
# `offset_bytes` to continue after a byte-limited result.
read:
  max_bytes: 262144
  hard_max_bytes: 4194304

# Time limits for one sub-agent job, in milliseconds. The job and every
# process below it are stopped when a limit expires. `timeout_ms` applies
# when neither the call nor the persona asks for one; `max_timeout_ms`
# bounds the one the model asks for. 0 removes either limit.
agent:
  timeout_ms: 0
  max_timeout_ms: 3600000
  # How a sub-agent child starts: `exec` runs fyai again, `fork` continues
  # the image of the parent. A transient run and a pinned root use `fork`.
  spawn: exec
  # Maximum nesting depth of sub-agent branches below a top-level branch.
  # Recursive delegation also uses this allocator limit.
  max_branch_depth: 8
  # Maximum number of live delegated agents across this invocation.
  max_live_agents: 16
  # Named sub-agent personas. The `persona` parameter of the agent tool picks
  # one; a key that a persona does not set keeps the value in force.
  personas:
    explore:
      description: Read-only search of the workspace.
      system_prompt: >-
        You are a search sub-agent. Find where things are and report back
        precisely. Do not change any file.
      reasoning:
        effort: low
      context: fresh
    review:
      description: Review a change for defects.
      system_prompt: >-
        You are a review sub-agent. Report defects with file and line, most
        severe first. Do not change any file.
      reasoning:
        effort: high

# Reasoning / thinking effort for reasoning-capable models. Maps to the
# Responses API `reasoning: { effort, summary }` and to Chat Completions
# `reasoning_effort` (summary is Responses-only and ignored otherwise). No
# dedicated flag - `config set reasoning/effort high` / `--set
# reasoning/effort=high`. Default is unset (no reasoning requested) - there
# is no valid enum value for "off", so the key is absent rather than null.
# reasoning:
#   effort: medium      # minimal | low | medium | high
#   summary: auto       # auto | concise | detailed

tools: true
# The native OpenAI shell tool runs one command on pipes. It cannot ask for a
# terminal or keep a named session, which `exec_command` does on every
# provider. Turn it on only if you want the provider-side tool.
builtin_shell: false
# Landlock-confine shell-tool sub-executions (Linux only; no-op elsewhere):
# read-only system paths, read/write the project and temp dirs, everything else
# denied. Best-effort - the allow-list/prompt remains the portable floor when
# Landlock is unavailable. Either a bool (enable with defaults) or a mapping:
#   sandbox:
#     enabled: true
#     deny:                 # carved out of the project (the .fyai arena is
#       - secrets           # always denied); paths are project-relative,
#       - ~/.ssh            # absolute (/...), or ~-relative
#     allow:                # extra grants outside the project
#       - /opt/toolchain            # string => read/write (rw)
#       - { path: /ro/data, mode: ro }      # read + execute only
#       - { path: /src, mode: edit }        # modify existing, no create/delete
#       - { path: /logs, mode: append }     # write without truncating
#       # modes: rw (default) | ro | edit | append
#     network:              # present => restrict egress to these TCP ports
#       ports: [443]        # (omit `network` entirely to leave egress open;
#                           #  empty ports denies all egress)
# `fyai sandbox on` stores this canned policy:
# sandbox: { enabled: true, deny: [secrets, ~/.ssh], network: { ports: [443] } }
sandbox: false

logprobs: false
top_logprobs: -1
token_extents: false     # record streamed token extents in turn metadata
no_obfuscation: false
whitewash_api_keys: true # redact API keys in wire logs
response_chain: false    # chain via previous_response_id (Responses API;
                          # missing server state falls back to local history)
no_auth: false           # skip the api_key requirement and the auth header,
                          # for local no-auth model servers (see "Local /
                          # self-hosted models" above)

# No default - computed at runtime (nearest .fyai walking up from cwd);
# override only to pin a specific arena location.
# arena_dir: /path/to/.fyai/arena

logging:
  wire: false
  stream: false
  conversation: false
  mcp: false

# --- Display / theming ------------------------------------------------------
#
# All stylistic options are grouped here (this nested form is the only one).
display:
  markdown: true          # render markdown output
  stream: true             # stream the response
  # Exchanges of history replayed when an interactive session starts:
  # -1 as many as the screen holds, 0 none.
  recap_exchanges: -1
  # How the live screen is composed: page states the screen as one UI Markdown
  # page (needs a libfytimui and a libfymd4c with page support, else stack is
  # used); stack draws the fixed chrome of the terminal library.
  renderer: page
  # Where a page stands, when the session starts: fullscreen takes the
  # alternate screen, where the transcript is a view that the wheel, PageUp
  # and PageDown scroll; inline keeps the transcript in the scrollback of the
  # terminal, which scrolls it as it scrolls any other program.
  screen: fullscreen
  # The page document of the page renderer, a YAML file; empty uses the
  # embedded data/page.yaml. `/page` shows the document in use.
  page: ""
  # Rendered rows of a bounded tool result.
  tool_preview_lines: 5
  # Minimum progressive tool redraw period; 0 redraws every update.
  tool_update_interval_ms: 33
  # none hides bodies; brief bounds all; default specializes; full shows all.
  tool_detail: default
  transcript_system: false # include system messages in transcript output
  # How streamed markdown is rendered (only with markdown + stream):
  markdown_mode: line      # line (per line, default) | stream (redraw per chunk) | oneshot (at end)
  # Minimum interval between progressive redraws in stream mode, 0 to 1000
  # milliseconds; 0 repaints every update.
  markdown_update_interval_ms: 50
  color: auto               # auto (colour iff a terminal) | off | on (force, even piped)
  # One theme controls Markdown, fenced code, and terminal chrome: a libfymd4c
  # theme (default, catppuccin, solarized, ...) or a libfypalette theme such as
  # ember. Append :auto, :dark, or :light to select its background variant.
  # `/theme` lists the themes of the build. ember:auto is the default of a
  # build with libfypalette; a build without it uses default:auto.
  theme: ember:auto
  # The background a palette theme draws for: theme uses the ground of the
  # theme (a fullscreen page fills its default backgrounds with it); terminal
  # asks the terminal for its background and keeps the neutral steps over it.
  theme_ground: theme
  # Override the selected theme's table border:
  # theme (follow the theme) | grid (force borders) | none (borderless).
  table_border: theme
  # Separators (rendered as markdown, themed by the renderer). turn_separator
  # breaks turns in the history view ("---" => a themed rule, "" => blank line);
  # tool_separator is rendered before each tool result; section_separator sits
  # between streamed reasoning and the answer. Empty ("") emits nothing / a
  # blank line.
  turn_separator: ""
  tool_separator: ""
  section_separator: ""
  # Blank rows, 0 to 8: around a tool exchange, and between the user card and
  # the answer under it.
  tool_group_fence: 1
  user_card_fence: 1
  # Interactive prompt bubble. prompt is the input marker; prompt_top and
  # prompt_bottom are {key} templates over the session vars (model, provider,
  # api, effort, summary, temp, ctx, branch, cwd, location).
  # prompt_bottom replaces the banner. All
  # may carry SGR colour escapes (e.g. "\e[36m{model}\e[0m"). The values below
  # are the built-in defaults; an empty string re-selects them (prompt then
  # falls back to "> " when markdown is off, "  > " with markdown).
  # The top row identifies the fyai branch and working directory; a blank row
  # stands above it. With a palette theme each value of prompt_top and
  # prompt_bottom takes the next colour of the theme's series.
  prompt: "  > "
  prompt_top: " {location}"
  # Branch diagrams use libfymermaid at the width granted by the work pane.
  # In /branches, g cycles tree/gitgraph/list. The setting below is the default.
  branch_view: tree
  # Where the branch and resume browsers render the end of the selected
  # session: auto (right of a wide pane, foot of a tall one) | right | bottom |
  # off. `p` cycles it in a browser. branch_preview_size is its share of the
  # pane in percent, 10 to 80.
  branch_preview: auto
  branch_preview_size: 40
  # Right-side preview width: half, quarter, 10%-80%, or exact columns.
  # When unset, branch_preview_size applies.
  # branch_preview_width: quarter
  # Empty follows light/dark; named themes: default, light, mono.
  diagram_theme: ""
  diagram_charset: auto
  # Gitgraph: legend moves long labels below; shrink compresses; clip crops.
  # Tree rows have fixed spacing; all fit policies clip long labels.
  diagram_fit: legend
  prompt_bottom: " {model} · {provider} · {api}{effort}{summary}{temp}{tokens}{cache}{cost}"
  # How the live screens of shell sessions and sub-agents share the work
  # pane: auto, columns, stack, main-top, or main-left.
  work_layout: auto
  work_columns: 0
  work_min_tile_cols: 40
  # Rows a tile keeps to scroll back to with its bar and the wheel; 0 keeps
  # none.
  work_history_rows: 1000
  # Where the pane stands: above-prompt, or below-prompt for the rows under
  # the input.
  work_position: above-prompt
  # Where an editor runs for /edit, config edit and a log view: pane runs it
  # in a tile of the work pane that takes the pane and the keys; terminal
  # gives it the whole terminal. Without an interactive UI it is the terminal.
  editor: pane
  # A further ceiling on work_zoom_rows; 0 leaves the height to it alone.
  work_max_rows: 0
  # Height of the work pane: full, half, quarter, or a positive row count.
  work_zoom_rows: half
  # The ground of what holds the keys - the prompt, a picker, a focused tile:
  # theme for the focus wash of a palette theme (reverse without one),
  # reverse for the ground the terminal draws text in, or #rrggbb for one of
  # your own. An empty string reverses the margin of the tile instead.
  # focus_bg_mix is how much of the ground reaches a cell the program
  # coloured itself.
  focus_bg: theme
  focus_bg_mix: 35
  # The chrome of the pane: work_frame above it, tile_frame around a tile,
  # tile_sep between two tiles of a row, and session_margin the gutter at the
  # left of a terminal session ("" draws none). work_cap draws a cap row with
  # the height, the tiles and the keys in place of work_frame.
  work_frame: none
  tile_frame: none
  tile_sep: " ┃ "
  session_margin: "  "
  work_cap: false
  # Mouse controls: full adds the buttons of a tile, a scroll bar and the
  # wheel; zoom adds the buttons alone; none disables them. Anything but none
  # takes the mouse for the session: selection and copy are then fyai's, which
  # copies through the terminal, and not the terminal's own.
  work_controls: full
  pretty: false           # pretty (YAML) debug dumps
  thinking: true           # display model reasoning/thinking output
  cache_info: false       # print provider cache info
  stats: false            # print session token usage to stderr

# --- MCP (Model Context Protocol) server support --------------------------
mcp:
  enabled: false
  # Hold the first model step until every server has settled, so the initial
  # turn sees the complete toolset. false submits optimistically while servers
  # keep connecting in the background.
  startup_wait: true
  # Legacy single-server form. Used as the server named "default" when
  # servers is empty.
  endpoint: ""
  auth_token: { type: env, value: MCP_API_KEY }
  protocol_version: "2024-11-05"
  timeout: 30
  # Named Streamable HTTP or local stdio servers. Per-server `enabled`,
  # `protocol_version`, `timeout`, and `auth_token` override the group values;
  # disabled entries are skipped. HTTP entries use `endpoint` and may set
  # `transport: streamable-http` (or the `http` alias). Stdio entries use
  # `transport: stdio`, `command`, optional `args`, `env`, and `cwd`.
  # HTTP authentication defaults to bearer-token mode. `auth: { type: oauth }`
  # enables discovery/browser OAuth and may also set `allow_browser`, `scopes`,
  # `authorization_params`, or a pre-registered `client`.
  # Tool names are exposed as mcp__<server>__<tool>.
  servers: {}
  # servers:
  #   github:
  #     endpoint: "https://api.githubcopilot.com/mcp/"
  #     auth_token: { type: env, value: GITHUB_TOKEN }
  #     enabled: true
  #     timeout: 30
  #   local:
  #     transport: stdio
  #     command: npx
  #     args: [-y, "@modelcontextprotocol/server-filesystem", .]
  #     env: { LOG_LEVEL: warn }
  #     cwd: .

# `catalog:` is written by fyai on every configuration commit: the catalogue
# entry of the configured model (display_name, context_window, capabilities,
# ...) and its canonical_provider. It is read-only; never set it by hand.

# Branch behaviour.
branch:
  # What to do when another invocation advanced this branch while this one was
  # running: abort (write nothing, the default), or replay our turns on top of
  # theirs with rebase or merge. Invocations on different branches never
  # conflict, so this only applies to the same branch.
  on_conflict: abort
