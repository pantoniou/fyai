# fyai configuration sample
#
# Install at $XDG_CONFIG_HOME/fyai/config.yaml (or ~/.config/fyai/config.yaml)
# to initialize a branch that has no stored configuration. Import a file with
# `fyai config import <file>` or edit stored configuration with
# `fyai config edit`. Inspect it with `fyai config export`.
#
# Configuration precedence: stored branch configuration (or the user file on
# initial setup), explicit --config/-C file, then command-line --set changes.
# The user file does not overlay an existing stored configuration. Unset keys
# use built-in defaults. --transient keeps changes and conversation state in
# memory without publishing them.
#
# Use slash-separated paths with `fyai config set|get|delete` or --set,
# --get, and --delete; for example, `fyai --set display/color=on`.
# Display settings are under display; logging settings are under logging.

# --- Model selection -------------------------------------------------------
#
# The catalogue maps model to provider, endpoint, API grammar, and wire ID.
# Prefix a model with `provider/` to select a specific provider; for example,
# `openrouter/glm-5.2`. --model/-m overrides this setting for one invocation.
model: gpt-5.4-mini

# Provider is derived from the selected model; it is not a configuration key.

# auto uses API-key precedence, then a saved ChatGPT login for OpenAI Responses.
auth: auto # auto | api-key | chatgpt

# API grammar: responses, chat-completions, or messages. Selecting another
# catalogue model re-derives the grammar and endpoint.
api: responses

# Set api_url to override the catalogue endpoint for the selected model/API.
# api_url: https://api.openai.com/v1/responses

# Automatic key lookup checks --api-key/-k, the provider's environment
# variable (such as OPENAI_API_KEY), then `api-key/<provider>` in the secret
# store. Use type: env or type: secret to select a specific source. Never
# place a raw credential in this file. Linux secrets do not survive reboot.
api_key: { type: auto }
# api_key: { type: env, value: OPENAI_API_KEY }
# api_key: { type: secret, value: api-key/openai }

# --- Local / self-hosted models ---------------------------------------------
#
# For a local server with a Chat Completions endpoint, set its model name and
# URL explicitly. Set no_auth only if the server does not require a key.
# An explicit URL does not require a catalogue entry for the model.
# model: llama3
# api: chat-completions
# api_url: http://localhost:11434/v1/chat/completions
# no_auth: true

# --- Top-level defaults ----------------------------------------------------
system_prompt: You are a concise assistant.
web_search: true
parallel_tool_calls: true
parallel_tool_calls_prompt: >-
  Independent tool calls may be issued together in one response and will
  execute in parallel. Keep dependent or potentially conflicting tool calls
  in separate responses.
temperature: 0
max_tool_iterations: 1000
# Output-token limit per request. Messages requests require this value;
# other grammars can derive it from the catalogue.
max_tokens: 8192

# Retry transient connection failures, timeouts, and HTTP 408, 429, 500, 502,
# 503, or 504. Delay doubles with jitter; Retry-After overrides that delay.
# max_attempts includes the first request (1 disables retries). max_delay_ms
# caps each delay; 0 removes the cap. Stream retries require no shown content.
retry:
  max_attempts: 8
  initial_delay_ms: 500
  max_delay_ms: 30000

# `fyai catalog update` runs a scrape-providers-compatible command with
# --format yaml and selection options. Only listed credentials are retained.
# timeout_ms limits the run; 0 disables the limit.
catalog_update:
  command: scrape-providers
  timeout_ms: 600000
  credentials:
    - ANTHROPIC_API_KEY
    - DEEPSEEK_API_KEY
    - FIREWORKS_API_KEY
    - META_API_KEY
    - OPENAI_API_KEY
    - OPENCODE_API_KEY

# Shell limits: timeout_ms applies when a call gives no timeout; max_timeout_ms
# caps a model-supplied timeout. max_output_tokens applies when a call gives
# no limit; hard_max_output_tokens caps a model-supplied limit. Truncation
# retains the end of output. Zero disables each limit.
#
# Empty shell selects /bin/sh. login reads the user's shell profile. A TTY
# call uses tty_term and tty_rows/tty_cols; 0 follows the terminal or uses
# 24 rows and 80 columns without one. tty enables a terminal by default.
# session_timeout_ms ends an idle named session. input_poll_ms controls how
# often the session checks whether its program waits for input; 0 disables
# either timer.
shell:
  timeout_ms: 120000
  max_timeout_ms: 600000
  max_output_tokens: 16384
  hard_max_output_tokens: 200000
  shell: ""
  login: false
  tty: false
  tty_rows: 0
  tty_cols: 0
  tty_term: xterm-256color
  session_timeout_ms: 900000
  input_poll_ms: 400

# read_file limits, in bytes: max_bytes is the default; hard_max_bytes caps a
# model-supplied value. Zero disables either limit. Use offset_bytes from a
# truncated result to continue reading.
read:
  max_bytes: 262144
  hard_max_bytes: 4194304

# Images that a message carries. max_bytes limits one attachment: a larger
# image is refused with a cause and is not scaled down. max_per_message
# limits how many one message carries. clipboard_command replaces the helper
# that /image paste finds, and must write one image to standard output;
# clipboard_timeout_ms limits how long that helper may run. Zero removes a
# limit.
media:
  max_bytes: 4194304
  max_per_message: 8
  clipboard_command: ""
  clipboard_timeout_ms: 5000

# Sub-agent advisory limits, in milliseconds. timeout_ms applies when neither
# the call nor persona sets one; max_timeout_ms caps a model-supplied limit.
# A completed agent reports whether it exceeded the advisory limit.
# timeout_kill stops an agent after hang_timeout_ms additional time, or after
# hang_timeout_ms from submission when no advisory limit is set.
# Set timeout_kill to false or hang_timeout_ms to 0 to disable termination.
agent:
  timeout_ms: 0
  max_timeout_ms: 3600000
  hang_timeout_ms: 600000
  timeout_kill: true
  # exec starts another fyai process; fork continues the child process.
  # Transient runs and pinned roots use fork.
  spawn: exec
  # Experimental, Linux only. Keep provider credentials in a separate
  # transport process; agent and tool processes are not given them. One of none,
  # auto, level-a (cgroup v2 subtree; not built yet) and level-b (PID and
  # pidfd only). auto takes level-b for now.
  transport_isolation: none
  # Linux only. none shares the project with the parent. view runs each
  # sub-agent in a private view of the project; its changes stay in the view
  # until the user applies them.
  isolation: none
  # Maximum depth of sub-agent branch paths, including ordinary components.
  max_branch_depth: 8
  # Maximum admitted agents in this invocation's descendant tree.
  max_live_agents: 16
  # Named personas selected by the agent tool. Unset keys inherit current
  # settings.
  personas:
    explore:
      description: Read-only search of the workspace.
      system_prompt: >-
        You are a search sub-agent. Find where things are and report back
        precisely. Do not change any file.
      reasoning:
        effort: low
      context: fresh
    review:
      description: Review a change for defects.
      system_prompt: >-
        You are a review sub-agent. Report defects with file and line, most
        severe first. Do not change any file.
      reasoning:
        effort: high

# Optional reasoning settings. Responses supports effort and summary; Chat
# Completions supports effort. Omit the whole mapping to request no reasoning
# setting; "off" and null are not valid effort values.
# reasoning:
#   effort: medium      # minimal | low | medium | high
#   summary: auto       # auto | concise | detailed

tools: true
# Limit what the model can do with the configuration: none, read, review
# (the user approves each change) or write (the classes of the schema).
model_access: review
# Enable the native OpenAI shell tool instead of the exec_command function.
# Native calls use pipes and cannot request a terminal or named session.
builtin_shell: false
# Landlock confines shell sub-executions on supported Linux systems, by the
# profile that `sandbox_profile` names. `none` confines nothing; any other name is
# a profile of `sandbox_profiles` below. Defaults grant read-only system paths and
# read/write project and temporary paths. Command admission remains separate from
# filesystem confinement. `/session profile NAME` selects one and restarts the
# session; `/session dev`, `/session lockdown` and `/session yolo` select `dev`,
# `lockdown` and `none` and set the other isolation keys too.
sandbox_profile: dev
# How a sandboxed tool hides the arena and the denied paths in a mount namespace:
# auto (a user namespace of the tool, else a holder that bubblewrap starts), userns,
# bwrap or none (Landlock alone, which stops a tool from creating entries in the
# project root).
sandbox_cover: auto
# What happens when the sandbox cannot be set up on this host, as when the profile
# makes mounts and user namespaces are not allowed. `warn` says why one time and
# runs the tool without the sandbox. `fail` stops the tool and says why.
sandbox_on_failure: warn
# How long the processes that a tool starts live. A program that detaches, as a
# build server does, lives for the exchange (the prompt to the end of the turn),
# and a terminal session or a monitor keeps it longer. `session` keeps it until
# the session ends; `call` ends it with the call that started it.
sandbox_scope: exchange
# The time that these processes have to stop after SIGTERM, in milliseconds, before
# SIGKILL ends them. A build server that saves its state needs time.
sandbox_grace_ms: 5000
# The profiles. This sample is the source of `dev` and `lockdown`: an arena that
# has none of them uses these, and one that stores them uses its own. A profile
# has a description, `extends` (the profile it starts from), `deny`, `allow`,
# `network`, `list_root`, `home` and `view` (the session runs in a view of the project).
#   deny:                 # Paths excluded from grants; .fyai is excluded.
#     - secrets           # Paths can be project-relative, absolute, or ~-relative.
#     - ~/.ssh
#   allow:                # Additional grants outside the project.
#     - /opt/toolchain    # String grants read/write access.
#     - { path: /ro/data, mode: ro }      # Read and execute.
#     - { path: /src, mode: edit }        # Modify existing files.
#     - { path: /logs, mode: append }     # Write without truncation.
#     # Modes: rw (default), ro, edit, append.
#   network:              # Restrict TCP and UDP independently.
#     tcp: { ports: [443], bind_ports: [] }
#     udp: { ports: [], bind_ports: [] } # Omit either protocol to leave it unrestricted.
# A key that a profile names replaces the key of the profile it extends, except
# `allow`, which adds to it. A path may use {{hostname}}, {{os}}, {{arch}} and {{host_specific}}
# (~/.fyai/hosts/{{hostname}}), so one profile serves hosts that differ.
sandbox_profiles:
  lockdown:
    description: the project and nothing else; no network; the session runs in a view
    view: true
    deny: [~/.ssh]       # The secret locations of the platform.
    allow: []
    network:
      tcp: { ports: [], bind_ports: [] }  # No TCP connects or binds.
      udp: { ports: [], bind_ports: [] }  # No UDP sends or binds on ABI 10.
  dev:
    description: project work with toolchains, and TCP to git and package registries
    view: false
    list_root: true      # A program that changes to / may open and list it.
    deny:
      - ~/.ssh
      - ~/.aws
      - ~/.gnupg
      - ~/.netrc
      - ~/.config/gh
      - ~/.docker
      - ~/.kube
      - ~/.npmrc
      - ~/.cargo/credentials.toml
    allow:               # The toolchains and package caches, and the git configuration.
      - { path: ~/.cargo/bin, mode: ro }
      - { path: ~/.rustup, mode: ro }
      - { path: ~/.cargo/registry, mode: rw }
      - { path: ~/.cargo/git, mode: rw }
      - { path: ~/.nvm, mode: ro }
      - { path: ~/.npm, mode: rw }
      - { path: ~/.local/share/pnpm, mode: rw }
      - { path: ~/.cache/yarn, mode: rw }
      - { path: ~/.cache/pip, mode: rw }
      - { path: ~/.cache/ccache, mode: rw }
      - { path: ~/.cache/go-build, mode: rw }
      - { path: ~/go/pkg, mode: rw }
      - { path: ~/go/bin, mode: ro }
      - { path: ~/.gitconfig, mode: ro }
      - { path: ~/.config/git, mode: ro }
    network:
      tcp: { ports: [80, 443, 9418] }     # git and the package registries.
      udp: { ports: [53] }                # DNS on ABI 10.
  build:
    description: the dev profile, and a program may make a user namespace (BitBake, Yocto)
    extends: dev
    expose: [userns]     # Needs a cover (sandbox_cover): a PID namespace and read-only /proc/sys.
  yocto:
    description: the build profile, with a home of its own (Yocto, BitBake)
    extends: build
    home:
      private: true      # No ~/.netrc is there, so a reader gets "not found", not EACCES.
      copy: [~/.gitconfig]
  dev-view:
    description: the dev profile, with the session in a view of the project
    extends: dev
    view: true           # Changes stay in the view until the session ends cleanly.
  # A home of its own for the tools, on top of `build`. A tree is mounted over the
  # real home in the namespace of the tool: HOME and its paths stay as they are, and
  # the tool sees only what is listed, and what the sandbox grants. It needs a cover.
  # build-home:
  #   description: a build with a private home
  #   extends: build
  #   home:
  #     private: true
  #     copy: [~/.bashrc, ~/.gitconfig, ~/.vimrc, ~/.config/nvim]
  #     env: [CARGO_HOME, "GIT_CONFIG_GLOBAL=~/.gitconfig"]   # Variables that name a path.
  #     method: overlay            # or copy.
  #   mounts:                      # Other mounts, made after the home.
  #     - { source: /dev/dri, mode: rw }
  # Add a profile of your own, starting from another:
  # node:
  #   description: a Node project
  #   extends: dev
  #   allow:
  #     - { path: "{{host_specific}}/tools", mode: ro }
  #   network:
  #     tcp: { ports: [80, 443, 3000] }   # git, registries and a dev server.
  #   view: true
# `sandbox_lockdown` is the legacy way to change lockdown, applied over the
# profile of that name:
# sandbox_lockdown:
#   deny: [~/.ssh]
#   network:
#     tcp:
#       ports: []
#       bind_ports: []
#     udp:
#       ports: []
#       bind_ports: []

logprobs: false
top_logprobs: -1
token_extents: false     # Record streamed token extents in turn metadata.
no_obfuscation: false
whitewash_api_keys: true # Redact API keys in wire logs.
response_chain: false    # Use previous_response_id for Responses requests;
                          # replay local history if server state is unavailable.
no_auth: false           # Do not require or send an API key.

# By default, fyai finds .fyai by walking up from the working directory.
# Set arena_dir to select a specific arena.
# arena_dir: /path/to/.fyai/arena

logging:
  wire: false
  stream: false
  conversation: false
  mcp: false
  transport: false

# --- Display / theming ------------------------------------------------------
#
# Display settings have no top-level equivalents.
display:
  markdown: true          # Render Markdown output.
  stream: true            # Present model output as it arrives.
  # Exchanges replayed at session start: -1 fills the screen; 0 skips replay.
  recap_exchanges: -1
  # fullscreen uses the alternate screen and a scrollable transcript view;
  # inline uses terminal scrollback.
  screen: fullscreen
  # YAML page document; empty selects embedded data/page.yaml.
  # `/page` reports the document in use.
  page: ""
  # Rendered rows shown for a bounded tool result.
  tool_preview_lines: 5
  # Rows of a running tool call that its tile keeps to scroll back through.
  tool_history_lines: 40
  # Minimum period between tool redraws; 0 redraws every update.
  tool_update_interval_ms: 33
  # Interval at which an idle UI wakes to look for changes that no component
  # announces. A longer one costs less CPU and shows such a change later.
  idle_poll_ms: 16
  # Tool result detail: none, brief, default, or full.
  tool_detail: default
  transcript_system: false # Include system messages in transcript output.
  # Markdown streaming mode: line renders each line; stream redraws on chunks;
  # oneshot renders at completion. Applies when markdown and stream are true.
  markdown_mode: line
  # Minimum interval between stream-mode redraws, in milliseconds;
  # 0 redraws every update.
  markdown_update_interval_ms: 50
  color: auto             # auto for terminals, off, or on even when piped.
  # Theme for Markdown, code, and terminal chrome. Select a variant with
  # :auto, :dark, or :light. `/theme` lists themes in this build.
  # Builds without libfypalette use default:auto.
  theme: ember:auto
  # Palette ground: theme fills default backgrounds of fullscreen pages;
  # terminal uses the detected terminal background.
  theme_ground: terminal
  # Table border: theme, grid, or none.
  table_border: theme
  # Markdown separators: turn_separator separates history exchanges;
  # tool_separator precedes a tool result; section_separator separates
  # reasoning from the answer. Empty strings add no rule.
  turn_separator: ""
  tool_separator: ""
  section_separator: ""
  # Blank rows around tool exchanges and below user cards (0 to 8).
  tool_group_fence: 1
  user_card_fence: 1
  # prompt is the input marker. prompt_top and prompt_bottom expand session
  # fields such as {location} and {model}; prompt_bottom replaces the banner.
  # Empty strings select built-in prompt defaults. Templates may contain SGR
  # escapes. Palette themes color template values in series order.
  # {isolation} is " · isolated LEVEL" while credential isolation is on and
  # empty otherwise; the default bottom row ends with it, and a template for
  # either row can place it.
  # {view} is " · view session" while the session runs in a view
  # (view/isolate_session), and empty otherwise.
  # {sandbox} is " · sandbox PROFILE" for the profile that confines the tools,
  # and " · no sandbox" when nothing confines them; the default top row ends
  # with it.
  prompt: "  > "
  # prompt_busy is the glyph of the prompt marker while a line would wait.
  # Empty takes the prompt.busy glyph of the theme, else an ellipsis.
  prompt_busy: ""
  prompt_top: " {location}{sandbox}"
  # Initial /branches view: tree or gitgraph; g cycles the available views.
  branch_view: tree
  # Browser preview placement: auto, right, bottom, or off; p cycles it.
  # branch_preview_size is the pane share in percent (10 to 80).
  branch_preview: auto
  branch_preview_size: 40
  # Right-side preview width: half, quarter, percent, or column count.
  # Unset uses branch_preview_size.
  # branch_preview_width: quarter
  # Empty follows the active variant; named themes: default, light, mono.
  diagram_theme: ""
  diagram_charset: auto
  # Gitgraph label fit: legend moves labels, shrink compresses, clip crops.
  # Tree layout clips long labels for every fit policy.
  diagram_fit: legend
  prompt_bottom: " {model} · {provider} · {api}{effort}{summary}{temp}{tokens}{cache}{cost}{isolation}{view}"
  # Work-pane tile arrangement: auto, columns, stack, main-top, or main-left.
  work_layout: auto
  work_columns: 0
  work_min_tile_cols: 40
  # The layout of the page document by name, or auto to choose it by size.
  page_layout: auto
  # A column of panels beside the transcript, from a side layout of the page
  # document: auto at its size, on at any size, off never. A size of 0 keeps
  # the size of the document.
  work_panels: auto
  work_panel_cols: 0
  work_panel_rows: 0
  # Scrollback rows retained per tile; 0 retains none.
  work_history_rows: 1000
  work_open_delay_ms: 500
  # Work-pane placement relative to the prompt.
  work_position: above-prompt
  # Completion popup: tab opens on Tab; auto opens when typing finds matches.
  completion: tab
  # Keys of the prompt, by mode (prompt, completion, surface): a key or a
  # chord of keys to an action of the terminal library, or "" to unbind it.
  # A chord such as "Escape Escape" waits chord_timeout_ms for its next key.
  # keys:
  #   prompt:
  #     Ctrl-r: fytim.redraw
  #     Ctrl-d: ""
  chord_timeout_ms: 1000
  # Slash-command output: transcript draws and stores the command and output;
  # pane shows a tile or popup without storing it.
  command_output: transcript
  # Session notices and warnings: transcript or a notice pane/popup.
  notice_output: transcript
  # Ground of command output in the transcript: theme mixes command_bg_mix
  # percent of the theme focus colour into the ground; #rrggbb or none.
  command_bg: theme
  command_bg_mix: 6
  # Live output of a shell or agent call: inline draws it in the transcript
  # at the call; pane shows a tile of the work pane.
  tool_display: inline
  # Rows of a terminal that tool_display inline draws in the transcript.
  inline_terminal_rows: 12
  # Editor location for /edit, config edit, and log views: pane or terminal.
  # Without an interactive UI, the editor uses the terminal.
  editor: pane
  # Additional work-pane row cap; 0 applies no additional cap.
  work_max_rows: 0
  # Work-pane height: full, half, quarter, or a positive row count.
  work_zoom_rows: half
  # Focus background for prompt, picker, and focused tile: theme uses the
  # palette focus role (or reverse without a palette); reverse uses terminal
  # reverse video; #rrggbb selects a color. Empty reverses only the margin.
  # focus_bg_mix controls the percentage mixed into program-colored cells.
  focus_bg: theme
  focus_bg_mix: 35
  # Focus mark: edge draws the edge column alone; wash also draws focus_bg.
  focus_mark: edge
  # Pane chrome: work_frame surrounds the pane, tile_frame ends each tile,
  # tile_sep divides columns, and session_margin precedes terminal rows.
  # work_cap replaces the upper frame with pane and tile status.
  work_frame: none
  tile_frame: none
  tile_sep: " ┃ "
  session_margin: "  "
  work_cap: false
  # Mouse controls: full adds buttons and scrolling; zoom adds buttons only;
  # none disables controls. With controls enabled, fyai handles selection.
  work_controls: full
  pretty: false           # Format debug dumps as YAML.
  thinking: true          # Display model reasoning output.
  cache_info: false       # Show provider cache information.
  stats: false            # Show session token usage.

# --- MCP (Model Context Protocol) server support --------------------------
mcp:
  enabled: false
  # Wait for all servers before the first model request. false permits a
  # request while servers continue connecting.
  startup_wait: true
  # Single-server endpoint, named "default" when servers is empty.
  endpoint: ""
  auth_token: { type: env, value: MCP_API_KEY }
  protocol_version: "2024-11-05"
  timeout: 30
  # Named Streamable HTTP or stdio servers. Server enabled, protocol_version,
  # timeout, and auth_token override group settings. HTTP uses endpoint;
  # stdio uses command with optional args, env, and cwd. OAuth authentication
  # uses auth: { type: oauth } and optional discovery/browser settings.
  # Exposed tool names have the form mcp__<server>__<tool>.
  servers: {}
  # servers:
  #   github:
  #     endpoint: "https://api.githubcopilot.com/mcp/"
  #     auth_token: { type: env, value: GITHUB_TOKEN }
  #     enabled: true
  #     timeout: 30
  #   local:
  #     transport: stdio
  #     command: npx
  #     args: [-y, "@modelcontextprotocol/server-filesystem", .]
  #     env: { LOG_LEVEL: warn }
  #     cwd: .

# fyai maintains the selected model's informational catalogue block on
# configuration commits. Do not set the derived model information manually.

# Branch conflict handling.
branch:
  # When another invocation advances this branch: abort without publishing,
  # or replay unpublished turns with rebase or merge. Other branches do not
  # conflict.
  on_conflict: abort

# New project views trade crash durability for fast capture by default.
view:
  durability: lazy
  # Directory that a view replaces with a private tmpfs. Empty selects $TMPDIR,
  # else /tmp.
  scratch_dir: ""
  # Record the project state with each ref-log entry that moves a head.
  track_project: false
  # Run each session and prompt in the view named session of the project.
  # Its changes stay in the view until `view apply session` takes them.
  # Show what each group of tool calls changed in the project, as a diff under
  # the calls, and let `/undo` take it back. A patch names its files only.
  tool_diff: false
  # The number of groups of tool calls that `/undo` can take back.
  undo_depth: 16
  # Paths that the diff and the apply of a view leave out, as lines of a gitignore
  # file. A view holds the whole project.
  ignore: []
  # Also leave out what the .gitignore files of the project ignore.
  gitignore: true
  isolate_session: false
  # Apply the view of a session to the project when it ends from an idle prompt and
  # no path conflicts. Otherwise the changes stay in the view.
  apply_on_exit: true
